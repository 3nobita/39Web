<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>
<body>
  <header class="navbar">

  <a href="/" class="logo">DEMO<span>.</span></a>

  <nav class="nav-links" id="navLinks">

    <button class="nav-item" data-menu="collection">
      COLLECTIONS <i class="fa-solid fa-chevron-down"></i>
    </button>  

    <button class="nav-item" data-menu="men">
      MEN <i class="fa-solid fa-chevron-down"></i>
    </button>

    <button class="nav-item" data-menu="women">
      WOMEN <i class="fa-solid fa-chevron-down"></i>
    </button>

    <a href="about">ABOUT US</a>  
    <a href="showcase">SALE</a>

    <div class="mobile-menu-extra">
      <a href="#">My Account</a>
      <a href="#">My Wishlist</a>
    </div>

  </nav>

  <div class="nav-actions">
    <button class="icon-btn" aria-label="Search">
      <i class="fa-solid fa-magnifying-glass"></i>
    </button>

    <button class="icon-btn" aria-label="Account">
      <i class="fa-regular fa-user"></i>
    </button>

    <button class="icon-btn" aria-label="Cart">
      <i class="fa-solid fa-bag-shopping"></i>
    </button>
  </div>

  <button class="menu-toggle" id="menuToggle" aria-label="Open menu">
    <i class="fa-solid fa-bars"></i>
  </button>

</header>
<!-- MEGA MENU -->
<div class="mega-menu" id="megaMenu">

  <div class="mega-inner">

    <div class="mega-top">
      <div>
        <span class="eyebrow">EXPLORE THE COLLECTION</span>
        <h2 id="megaTitle">MEN'S COLLECTION</h2>
      </div>

      <button class="mega-close" id="megaClose" aria-label="Close menu">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <!-- IMAGE COLLECTIONS -->
    <div class="mega-feature-grid" id="megaFeatureGrid">

      <a href="/showcase" class="mega-feature">
        <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRDj7ifc1RjOudihPvHEMoAyEOKxTeGBJFItYXs2o3SfP_gQYbfgY0iIoqs&s=10" alt="New arrivals">
        <div>
          <span>JUST DROPPED</span>
          <h3>NEW ARRIVALS ↗</h3>
        </div>
      </a>

      <a href="/showcase" class="mega-feature">
        <img src="https://i.pinimg.com/originals/f0/83/13/f083137eb9ca177fed5e281275fb0b42.jpg" alt="T-shirts">
        <div>
          <span>EVERYDAY ESSENTIALS</span>
          <h3>T-SHIRTS ↗</h3>
        </div>
      </a>

      <a href="/showcase" class="mega-feature">
        <img src="https://cdn.shopify.com/s/files/1/0573/3144/9992/files/1Screenshot_2025-05-16_133811.png?v=1747383092" alt="Trending fashion">
        <div>
          <span>THE LATEST LOOKS</span>
          <h3>TRENDING ↗</h3>
        </div>
      </a>

    </div>

    <!-- HORIZONTAL CATEGORY SCROLL -->
    <div class="mega-category-area">

      <div class="mega-category-heading">
        <h3>SHOP BY CATEGORY</h3>
        <span>DISCOVER MORE ✦</span>
      </div>

      <div class="mega-category-scroll" id="megaCategories">

        <a href="#">T-Shirts</a>
        <a href="#">Oversized Tees</a>
        <a href="#">Shirts</a>
        <a href="#">Polos</a>
        <a href="#">Jeans</a>
        <a href="#">Joggers</a>
        <a href="#">Sneakers</a>
        <a href="#">Accessories</a>

      </div>

    </div>

    <!-- QUICK LINKS -->
    <!-- <div class="mega-bottom">

      <div>
        <span>01</span>
        <a href="#">BESTSELLERS</a>
      </div>

      <div>
        <span>02</span>
        <a href="#">MOST LOVED</a>
      </div>

      <div>
        <span>03</span>
        <a href="#categories">EXPLORE ALL</a>
      </div>

    </div> -->

  </div>

</div>

<div class="mega-backdrop" id="megaBackdrop"></div>

<script src="/js/script.js"></script>
</body>
</html>


